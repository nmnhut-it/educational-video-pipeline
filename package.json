{
  "name": "educational-video-pipeline",
  "version": "1.0.0",
  "description": "Narrated educational videos from a JSON slide script: Remotion + pluggable text-to-speech",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render EducationalVideo output/video.mp4",
    "generate-audio": "npx tsx scripts/generate-audio.ts",
    "validate": "npx tsx scripts/validate-script.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "remotion": "4.0.242",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2",
    "dotenv": "^16.4.7",
    "@types/node": "^22.10.2"
  }
}
