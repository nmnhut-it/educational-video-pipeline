{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoScript",
  "description": "Schema for educational video slide decks rendered by Remotion",
  "type": "object",
  "required": ["title", "slides"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title shown in metadata"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/titleSlide" },
          { "$ref": "#/$defs/sectionHeaderSlide" },
          { "$ref": "#/$defs/conceptSlide" },
          { "$ref": "#/$defs/codeSlide" },
          { "$ref": "#/$defs/diagramSlide" },
          { "$ref": "#/$defs/flowSlide" },
          { "$ref": "#/$defs/tableSlide" },
          { "$ref": "#/$defs/outroSlide" },
          { "$ref": "#/$defs/imageSlide" }
        ]
      }
    }
  },
  "$defs": {
    "slideBase": {
      "type": "object",
      "required": ["id", "type", "section", "narration"],
      "properties": {
        "id": { "type": "string", "pattern": "^slide-\\d{2,}$" },
        "type": { "type": "string" },
        "section": { "type": "string" },
        "narration": { "type": "string" }
      }
    },
    "titleSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["title", "subtitle"],
          "properties": {
            "type": { "const": "title" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" }
          }
        }
      ]
    },
    "sectionHeaderSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["stageNumber", "heading", "tagline"],
          "properties": {
            "type": { "const": "section-header" },
            "stageNumber": { "type": "integer", "minimum": 1 },
            "heading": { "type": "string" },
            "tagline": { "type": "string" }
          }
        }
      ]
    },
    "conceptSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["heading", "bullets"],
          "properties": {
            "type": { "const": "concept" },
            "heading": { "type": "string" },
            "bullets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "highlight": { "type": "string" },
            "flow": {
              "type": "array",
              "items": { "$ref": "#/$defs/flowNode" }
            }
          }
        }
      ]
    },
    "codeSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["heading", "language", "code"],
          "properties": {
            "type": { "const": "code" },
            "heading": { "type": "string" },
            "language": { "type": "string" },
            "code": { "type": "string" },
            "caption": { "type": "string" }
          }
        }
      ]
    },
    "diagramSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["heading", "nodes", "edges"],
          "properties": {
            "type": { "const": "diagram" },
            "heading": { "type": "string" },
            "nodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagramNode" }
            },
            "edges": {
              "type": "array",
              "items": { "$ref": "#/$defs/diagramEdge" }
            },
            "diagramLines": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "flowSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["heading", "nodes"],
          "properties": {
            "type": { "const": "flow" },
            "heading": { "type": "string" },
            "nodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/flowNode" },
              "minItems": 2
            },
            "summary": { "type": "string" }
          }
        }
      ]
    },
    "tableSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["heading", "headers", "rows"],
          "properties": {
            "type": { "const": "table" },
            "heading": { "type": "string" },
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "outroSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["title", "message", "evolutionLine"],
          "properties": {
            "type": { "const": "outro" },
            "title": { "type": "string" },
            "message": { "type": "string" },
            "evolutionLine": { "type": "string" }
          }
        }
      ]
    },
    "diagramNode": {
      "type": "object",
      "required": ["id", "label", "row", "col"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "sublabels": { "type": "array", "items": { "type": "string" } },
        "row": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 },
        "color": { "enum": ["blue", "green", "orange", "purple", "red"] }
      }
    },
    "diagramEdge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "flowNode": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" }
      }
    },
    "imageSlide": {
      "allOf": [
        { "$ref": "#/$defs/slideBase" },
        {
          "type": "object",
          "required": ["imagePath"],
          "properties": {
            "type": { "const": "image" },
            "imagePath": {
              "type": "string",
              "description": "Path relative to public/ — e.g. pptx-slides/Slide1.PNG. Must match exact filename and extension case."
            }
          }
        }
      ]
    }
  }
}
